# URL target ClientHub (Live Subdomain/Path atau Local)
CLIENTHUB_BASE_URL=https://client.stevenarif.my.id

# API Key dari admin ClientHub untuk autentikasi X-API-Key tanpa kedaluwarsa
CLIENTHUB_API_KEY=your_clienthub_api_key_here

# (Opsional) Kredensial Login Admin jika tidak memakai API Key
CLIENTHUB_USERNAME=admin
CLIENTHUB_PASSWORD=your_admin_password_here
